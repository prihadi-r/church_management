<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_news_category_list" model="ir.ui.view">
            <field name="name">church.news.category.list</field>
            <field name="model">church.news.category</field>
            <field name="arch" type="xml">
                <list string="News Categories">
                    <field name="sequence"/>
                    <field name="name"/>
                    <field name="slug"/>
                    <field name="keywords"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <record id="view_news_category_form" model="ir.ui.view">
            <field name="name">church.news.category.form</field>
            <field name="model">church.news.category</field>
            <field name="arch" type="xml">
                <form string="News Category">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="slug"/>
                                <field name="sequence"/>
                            </group>
                            <group>
                                <field name="color"/>
                                <field name="active"/>
                            </group>
                        </group>
                        <group string="Auto-categorization keywords">
                            <field name="keywords"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_news_category" model="ir.actions.act_window">
            <field name="name">News Categories</field>
            <field name="res_model">church.news.category</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
