<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- ========================================== -->
        <!-- MISSION : MASTER DATA                      -->
        <!-- ========================================== -->

        <!-- MISSION FIELD -->
        <record id="action_church_mission_field" model="ir.actions.act_window">
            <field name="name">Mission Fields</field>
            <field name="res_model">church.mission.field</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="view_church_mission_field_list" model="ir.ui.view">
            <field name="name">church.mission.field.list</field>
            <field name="model">church.mission.field</field>
            <field name="arch" type="xml">
                <list string="Mission Fields" editable="bottom">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="parent_id"/>
                    <field name="country_id"/>
                    <field name="color" widget="color_picker"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <record id="view_church_mission_field_form" model="ir.ui.view">
            <field name="name">church.mission.field.form</field>
            <field name="model">church.mission.field</field>
            <field name="arch" type="xml">
                <form string="Mission Field">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="code"/>
                                <field name="parent_id"/>
                                <field name="country_id"/>
                            </group>
                            <group>
                                <field name="sequence"/>
                                <field name="color" widget="color_picker"/>
                                <field name="active"/>
                            </group>
                        </group>
                        <group string="Sub Fields">
                            <field name="child_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="code"/>
                                    <field name="country_id"/>
                                </list>
                            </field>
                        </group>
                        <group string="Description">
                            <field name="description" placeholder="Field description..."/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_church_mission_field_search" model="ir.ui.view">
            <field name="name">church.mission.field.search</field>
            <field name="model">church.mission.field</field>
            <field name="arch" type="xml">
                <search string="Mission Field">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="country_id"/>
                    <filter name="filter_inactive" string="Archived"
                            domain="[('active', '=', False)]"/>
                </search>
            </field>
        </record>

