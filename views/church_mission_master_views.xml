        <!-- MISSION AGENCY -->
        <record id="action_church_mission_agency" model="ir.actions.act_window">
            <field name="name">Mission Agencies</field>
            <field name="res_model">church.mission.agency</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="view_church_mission_agency_list" model="ir.ui.view">
            <field name="name">church.mission.agency.list</field>
            <field name="model">church.mission.agency</field>
            <field name="arch" type="xml">
                <list string="Mission Agencies">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="email"/>
                    <field name="phone"/>
                    <field name="city"/>
                    <field name="missionary_count"/>
                    <field name="trip_count"/>
                </list>
            </field>
        </record>

        <record id="view_church_mission_agency_form" model="ir.ui.view">
            <field name="name">church.mission.agency.form</field>
            <field name="model">church.mission.agency</field>
            <field name="arch" type="xml">
                <form string="Mission Agency">
                    <sheet>
                        <div class="oe_title">
                            <label for="name" string="Agency"/>
                            <h1>
                                <field name="name" placeholder="Agency name"/>
                            </h1>
                        </div>
                        <group>
                            <group>
                                <field name="code"/>
                                <field name="partner_id"/>
                                <field name="website" widget="url"/>
                                <field name="field_ids" widget="many2many_tags"/>
                            </group>
                            <group>
                                <field name="email" widget="email"/>
                                <field name="phone" widget="phone"/>
                                <field name="street"/>
                                <field name="city"/>
                                <field name="country_id"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Missionaries" name="missionaries">
                                <field name="missionary_ids" readonly="1">
                                    <list>
                                        <field name="name"/>
                                        <field name="field_id"/>
                                        <field name="status_id" widget="badge"/>
                                        <field name="support_progress"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Mission Trips" name="trips">
                                <field name="trip_ids" readonly="1">
                                    <list>
                                        <field name="name"/>
                                        <field name="date_begin"/>
                                        <field name="status_id" widget="badge"/>
                                        <field name="participant_count"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Notes" name="notes">
                                <field name="notes" placeholder="Agency notes..."/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_church_mission_agency_search" model="ir.ui.view">
            <field name="name">church.mission.agency.search</field>
            <field name="model">church.mission.agency</field>
            <field name="arch" type="xml">
                <search string="Mission Agency">
                    <field name="name"/>
                    <field name="code"/>
                    <field name="field_ids"/>
                    <field name="email"/>
                    <filter name="filter_inactive" string="Archived"
                            domain="[('active', '=', False)]"/>
                    <group expand="0" string="Group By">
                        <filter name="group_by_country" string="Country"
                                context="{'group_by': 'country_id'}"/>
                    </group>
                </search>
            </field>
        </record>
    </data>
</odoo>
