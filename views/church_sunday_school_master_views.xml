<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- ========================================== -->
        <!-- SUNDAY SCHOOL : MASTER DATA                -->
        <!-- ========================================== -->

        <!-- CLASS LEVEL -->
        <record id="action_church_sunday_school_level" model="ir.actions.act_window">
            <field name="name">Class Levels</field>
            <field name="res_model">church.sunday.school.class.level</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="view_church_sunday_school_level_list" model="ir.ui.view">
            <field name="name">church.sunday.school.class.level.list</field>
            <field name="model">church.sunday.school.class.level</field>
            <field name="arch" type="xml">
                <list string="Class Levels" editable="bottom">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="code"/>
                    <field name="color" widget="color_picker"/>
                    <field name="description" optional="hide"/>
                    <field name="active" widget="boolean_toggle"/>
                </list>
            </field>
        </record>

        <record id="view_church_sunday_school_level_form" model="ir.ui.view">
            <field name="name">church.sunday.school.class.level.form</field>
            <field name="model">church.sunday.school.class.level</field>
            <field name="arch" type="xml">
                <form string="Class Level">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="code"/>
                                <field name="sequence"/>
                            </group>
                            <group>
                                <field name="color" widget="color_picker"/>
                                <field name="active"/>
                            </group>
                        </group>
                        <field name="description"/>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_church_sunday_school_level_search" model="ir.ui.view">
            <field name="name">church.sunday.school.class.level.search</field>
            <field name="model">church.sunday.school.class.level</field>
            <field name="arch" type="xml">
                <search string="Class Level">
                    <field name="name"/>
                    <field name="code"/>
                    <filter name="filter_inactive" string="Archived"
                            domain="[('active', '=', False)]"/>
                </search>
            </field>
        </record>

