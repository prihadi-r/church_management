<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Christianity News section added to the website homepage.
        This belongs to church_management (the news feature lives here) and is
        independent of the website theme, so it works even without church_theme.
    -->
    <template id="homepage_news" inherit_id="website.homepage"
              name="Homepage Christianity News" active="True">
        <xpath expr="//div[@id='wrap']" position="inside">
            <section class="s_text_block s_section_padding" data-snippet="homepage_news"
                     data-name="Christianity News">
                <div class="container">
                    <div class="text-center">
                        <p class="text-uppercase text-primary font-weight-bold mb-2">Stay Informed</p>
                        <h2 class="h1 mb-3">Christianity News</h2>
                        <p class="lead text-muted mb-4">
                            Latest headlines from trusted Christian news sources, curated for your church.
                        </p>
                        <a href="/christianity-news" class="btn btn-primary btn-lg">Read Christianity News</a>
                    </div>
                </div>
            </section>
        </xpath>
    </template>
</odoo>
