<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- Sequence otomatis untuk nomor referensi Pray Request -->
        <record id="seq_church_pray_request" model="ir.sequence">
            <field name="name">Prayer Request</field>
            <field name="code">church.pray.request</field>
            <field name="prefix">PRAY/%(year)s/</field>
            <field name="padding">4</field>
        </record>

        <record id="action_church_pray_request" model="ir.actions.act_window">
            <field name="name">Pray Requests</field>
            <field name="res_model">church.pray.request</field>
            <field name="view_mode">kanban,calendar,list,pivot,form</field>
            <field name="context">{'search_default_group_by_state': 1}</field>
        </record>

        <!-- Calendar -->
        <record id="view_church_pray_request_calendar" model="ir.ui.view">
            <field name="name">church.pray.request.calendar</field>
            <field name="model">church.pray.request</field>
            <field name="arch" type="xml">
                <calendar string="Pray Request Calendar" date_start="create_date" color="color" quick_create="false">
                    <field name="name_request"/>
                    <field name="requester_name"/>
                    <field name="state" widget="badge"/>
                </calendar>
            </field>
        </record>

        <!-- Kanban (grouped by state) -->
        <record id="view_church_pray_request_kanban" model="ir.ui.view">
            <field name="name">church.pray.request.kanban</field>
            <field name="model">church.pray.request</field>
            <field name="arch" type="xml">
                <kanban default_group_by="state" group_create="true" group_edit="true" group_delete="true">
                    <field name="state"/>
                    <field name="color"/>
                    <field name="name_request"/>
                    <field name="requester_name"/>
                    <field name="create_date"/>
                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_global_click" t-att-class="kanban_color(record.color.raw_value)">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_title">
                                        <field name="name_request"/>
                                    </div>
                                    <div class="o_kanban_record_options">
                                        <field name="state" widget="badge"/>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div>
                                        <div t-if="record.requester_name.raw_value">
                                            <i class="fa fa-user"/> <field name="requester_name"/>
                                        </div>
                                        <div>
                                            <i class="fa fa-calendar"/> <field name="create_date"/>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Pivot (cohort-style grid): count of requests per period by status -->
        <record id="view_church_pray_request_pivot" model="ir.ui.view">
            <field name="name">church.pray.request.pivot</field>
            <field name="model">church.pray.request</field>
            <field name="arch" type="xml">
                <pivot string="Pray Requests (Cohort)">
                    <field name="create_date" type="row"/>
                    <field name="state" type="col"/>
                </pivot>
            </field>
        </record>

        <!-- List / Grid -->
        <record id="view_church_pray_request_list" model="ir.ui.view">
            <field name="name">church.pray.request.list</field>
            <field name="model">church.pray.request</field>
            <field name="arch" type="xml">
                <list string="Pray Requests">
                    <field name="name"/>
                    <field name="name_request"/>
                    <field name="requester_name"/>
                    <field name="requester_email"/>
                    <field name="create_date"/>
                    <field name="session_ids" widget="many2many_tags"/>
                    <field name="state" widget="badge" decoration-success="state == 'answered'" decoration-info="state == 'in_progress'" decoration-warning="state == 'new'" decoration-muted="state == 'closed'"/>
                </list>
            </field>
        </record>

        <!-- Form -->
        <record id="view_church_pray_request_form" model="ir.ui.view">
            <field name="name">church.pray.request.form</field>
            <field name="model">church.pray.request</field>
            <field name="arch" type="xml">
                <form string="Pray Request">
                    <header>
                        <button name="action_start" type="object" string="Start Praying" invisible="state != 'new'" class="btn-primary"/>
                        <button name="action_answered" type="object" string="Mark Answered" invisible="state != 'in_progress'" class="btn-success"/>
                        <button name="action_close" type="object" string="Close" invisible="state not in ('new', 'in_progress', 'answered')" class="btn-secondary"/>
                        <button name="action_reopen" type="object" string="Reopen" invisible="state != 'closed'" class="btn-secondary"/>
                        <field name="state" widget="statusbar"/>
                    </header>
                    <sheet>
                        <group>
                            <group string="Request">
                                <field name="name" readonly="1"/>
                                <field name="name_request"/>
                                <field name="description"/>
                            </group>
                            <group string="Requester">
                                <field name="requester_id" options="{'no_create': True}"/>
                                <field name="requester_name"/>
                                <field name="requester_email"/>
                                <field name="requester_phone"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Prayer Sessions">
                                <field name="session_ids">
                                    <list editable="bottom">
                                        <field name="name"/>
                                        <field name="datetime"/>
                                        <field name="prayer_ids" widget="many2many_tags"/>
                                        <field name="note"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Search -->
        <record id="view_church_pray_request_search" model="ir.ui.view">
            <field name="name">church.pray.request.search</field>
            <field name="model">church.pray.request</field>
            <field name="arch" type="xml">
                <search string="Pray Request">
                    <field name="name"/>
                    <field name="name_request"/>
                    <field name="requester_name"/>
                    <field name="requester_email"/>
                    <filter name="state_new" string="New" domain="[('state','=','new')]"/>
                    <filter name="state_in_progress" string="In Progress" domain="[('state','=','in_progress')]"/>
                    <filter name="state_answered" string="Answered" domain="[('state','=','answered')]"/>
                    <filter name="state_closed" string="Closed" domain="[('state','=','closed')]"/>
                    <group expand="0" string="Group By">
                        <filter name="group_by_state" string="Status" context="{'group_by':'state'}"/>
                        <filter name="group_by_requester" string="Requester" context="{'group_by':'requester_id'}"/>
                        <filter name="group_by_create_date" string="Create Date" context="{'group_by':'create_date'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Menu di bawah Operations -->
        <menuitem id="menu_church_pray_request"
                  name="Pray Requests"
                  parent="menu_church_operations"
                  action="action_church_pray_request"
                  sequence="37"/>

    </data>
</odoo>
