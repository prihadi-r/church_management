<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_news_article_list" model="ir.ui.view">
            <field name="name">church.news.article.list</field>
            <field name="model">church.news.article</field>
            <field name="arch" type="xml">
                <list string="News Articles" create="false" edit="false">
                    <field name="title"/>
                    <field name="source_id"/>
                    <field name="published_date"/>
                    <field name="original_url"/>
                </list>
            </field>
        </record>

        <record id="view_news_article_form" model="ir.ui.view">
            <field name="name">church.news.article.form</field>
            <field name="model">church.news.article</field>
            <field name="arch" type="xml">
                <form string="News Article">
                    <sheet>
                        <group>
                            <group>
                                <field name="title"/>
                                <field name="source_id"/>
                            </group>
                            <group>
                                <field name="published_date"/>
                                <field name="original_url"/>
                            </group>
                        </group>
                        <group>
                            <field name="summary"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_news_article" model="ir.actions.act_window">
            <field name="name">News Articles</field>
            <field name="res_model">church.news.article</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
