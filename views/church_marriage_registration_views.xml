<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="action_church_marriage_registration" model="ir.actions.act_window">
            <field name="name">Marriage Registrations</field>
            <field name="res_model">church.marriage.registration</field>
            <field name="view_mode">kanban,calendar,list,form</field>
        </record>

        <record id="view_church_marriage_registration_calendar" model="ir.ui.view">
            <field name="name">church.marriage.registration.calendar</field>
            <field name="model">church.marriage.registration</field>
            <field name="arch" type="xml">
                <calendar string="Marriage Calendar" date_start="marriage_datetime" color="color" quick_create="false">
                    <field name="name"/>
                    <field name="state" widget="badge"/>
                </calendar>
            </field>
        </record>

        <record id="view_church_marriage_registration_kanban" model="ir.ui.view">
            <field name="name">church.marriage.registration.kanban</field>
            <field name="model">church.marriage.registration</field>
            <field name="arch" type="xml">
                <kanban default_group_by="state" group_create="true" group_edit="true" group_delete="true">
                    <field name="state"/>
                    <field name="color"/>
                    <field name="name"/>
                    <field name="marriage_datetime"/>
                    <field name="groom_id"/>
                    <field name="bride_id"/>
                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_global_click" t-att-class="kanban_color(record.color.raw_value)">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_title">
                                        <field name="name"/>
                                    </div>
                                    <div class="o_kanban_record_options">
                                        <field name="state" widget="badge"
                                               decoration-danger="state == 'cancel'"
                                               decoration-warning="state == 'review'"
                                               decoration-info="state == 'approved'"
                                               decoration-success="state == 'done'"/>
                                    </div>
                                </div>
                                <div class="o_kanban_record_bottom">
                                    <div>
                                        <field name="marriage_datetime"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <record id="view_church_marriage_registration_list" model="ir.ui.view">
            <field name="name">church.marriage.registration.list</field>
            <field name="model">church.marriage.registration</field>
            <field name="arch" type="xml">
                <list string="Marriage Registrations">
                    <field name="name"/>
                    <field name="groom_id"/>
                    <field name="bride_id"/>
                    <field name="marriage_datetime"/>
                    <field name="sacrament_type_id"/>
                    <field name="state" widget="badge" decoration-success="state == 'done'" decoration-info="state == 'approved'" decoration-warning="state == 'review'" decoration-danger="state == 'cancel'"/>
                </list>
            </field>
        </record>

        <record id="view_church_marriage_registration_form" model="ir.ui.view">
            <field name="name">church.marriage.registration.form</field>
            <field name="model">church.marriage.registration</field>
            <field name="arch" type="xml">
                <form string="Marriage Registration">
                    <header>
                        <button name="action_submit" type="object" string="Submit for Review" invisible="state != 'draft'" class="btn-primary"/>
                        <button name="action_approve" type="object" string="Approve" invisible="state != 'review'" class="btn-success"/>
                        <button name="action_done" type="object" string="Mark Completed" invisible="state != 'approved'" class="btn-success"/>
                        <button name="action_cancel" type="object" string="Cancel" invisible="state not in ('draft', 'review', 'approved')" class="btn-secondary"/>
                        <button name="action_draft" type="object" string="Reset to Draft" invisible="state != 'cancel'" class="btn-secondary"/>
                    </header>
                    <sheet>
                        <group>
                            <group string="Couple">
                                <field name="groom_id"/>
                                <field name="bride_id"/>
                                <field name="name" readonly="1"/>
                            </group>
                            <group string="Marriage Details">
                                <field name="marriage_datetime"/>
                                <field name="sacrament_type_id"/>
                                <field name="pastor_id"
                                       domain="[('is_pastor', '=', True)]"
                                       options="{'no_create': True}"/>
                                <field name="state"/>
                            </group>
                        </group>
                        <group string="Notes">
                            <field name="notes"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_church_marriage_registration_search" model="ir.ui.view">
            <field name="name">church.marriage.registration.search</field>
            <field name="model">church.marriage.registration</field>
            <field name="arch" type="xml">
                <search string="Marriage Registration">
                    <field name="name"/>
                    <field name="groom_id"/>
                    <field name="bride_id"/>
                    <field name="marriage_datetime"/>
                    <filter name="state_draft" string="Draft" domain="[('state','=','draft')]"/>
                    <filter name="state_review" string="Under Review" domain="[('state','=','review')]"/>
                    <filter name="state_approved" string="Approved" domain="[('state','=','approved')]"/>
                    <filter name="state_done" string="Completed" domain="[('state','=','done')]"/>
                    <group expand="0" string="Group By">
                        <filter name="group_by_state" string="Status" context="{'group_by':'state'}"/>
                        <filter name="group_by_datetime" string="Marriage Datetime" context="{'group_by':'marriage_datetime'}"/>
                    </group>
                </search>
            </field>
        </record>
    </data>
</odoo>
