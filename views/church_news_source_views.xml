<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_news_source_list" model="ir.ui.view">
            <field name="name">church.news.source.list</field>
            <field name="model">church.news.source</field>
            <field name="arch" type="xml">
                <list string="News Sources" create="true" edit="true">
                    <field name="name"/>
                    <field name="url"/>
                    <field name="rss_feed_url"/>
                    <field name="active"/>
                </list>
            </field>
        </record>

        <record id="view_news_source_form" model="ir.ui.view">
            <field name="name">church.news.source.form</field>
            <field name="model">church.news.source</field>
            <field name="arch" type="xml">
                <form string="News Source">
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="url"/>
                            </group>
                            <group>
                                <field name="rss_feed_url"/>
                                <field name="active"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="action_news_source" model="ir.actions.act_window">
            <field name="name">News Sources</field>
            <field name="res_model">church.news.source</field>
            <field name="view_mode">list,form</field>
        </record>

    </data>
</odoo>
