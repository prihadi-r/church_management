        <!-- ========================================== -->
        <!-- 2. MEMBER TYPES                            -->
        <!-- ========================================== -->
        <record id="action_church_member_type" model="ir.actions.act_window">
            <field name="name">Member Types</field>
            <field name="res_model">church.member.type</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="view_church_member_type_list" model="ir.ui.view">
            <field name="name">church.member.type.list</field>
            <field name="model">church.member.type</field>
            <field name="arch" type="xml">
                <list>
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="view_church_member_type_form" model="ir.ui.view">
            <field name="name">church.member.type.form</field>
            <field name="model">church.member.type</field>
            <field name="arch" type="xml">
                <form string="Member Type">
                    <sheet>
                        <group>
                            <field name="name"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_church_member_type_search" model="ir.ui.view">
            <field name="name">church.member.type.search</field>
            <field name="model">church.member.type</field>
            <field name="arch" type="xml">
                <search string="Member Type">
