<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <record id="action_church_musician_role" model="ir.actions.act_window">
            <field name="name">Musician Roles</field>
            <field name="res_model">church.musician.role</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="view_church_musician_role_list" model="ir.ui.view">
            <field name="name">church.musician.role.list</field>
            <field name="model">church.musician.role</field>
            <field name="arch" type="xml">
                <list string="Musician Roles">
                    <field name="name"/>
                </list>
            </field>
        </record>

        <record id="view_church_musician_role_form" model="ir.ui.view">
            <field name="name">church.musician.role.form</field>
            <field name="model">church.musician.role</field>
            <field name="arch" type="xml">
                <form string="Musician Role">
                    <sheet>
                        <group>
                            <field name="name"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_church_musician_role_search" model="ir.ui.view">
            <field name="name">church.musician.role.search</field>
            <field name="model">church.musician.role</field>
            <field name="arch" type="xml">
                <search string="Musician Role">
                    <field name="name"/>
                </search>
            </field>
        </record>
    </data>
</odoo>
