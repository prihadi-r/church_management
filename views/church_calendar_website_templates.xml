<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="church_calendar_page" name="Church Calendar Public Page">
        <t t-call="website.layout">
            <div id="wrap">
                <style>
                    .cc-hero {
                        background: linear-gradient(135deg, #2c3e50 0%, #4a6b8a 100%);
                        color: #fff;
                        padding: 3.5rem 0;
                        text-align: center;
                    }
                    .cc-hero h1 { font-weight: 700; font-size: 2.25rem; }
                    .cc-hero p { opacity: .9; margin-bottom: 0; }
                    .cc-month { margin-top: 2.5rem; }
                    .cc-month-title {
                        font-size: 1.4rem;
                        font-weight: 700;
                        color: #2c3e50;
                        border-bottom: 2px solid #e8e8e8;
                        padding-bottom: .5rem;
                        margin-bottom: 1.25rem;
                    }
                    .cc-item {
                        display: flex;
                        align-items: center;
                        padding: .9rem 1.1rem;
                        border: 1px solid #eaeaea;
                        border-left: 4px solid #bdc3c7;
                        border-radius: 6px;
                        margin-bottom: .75rem;
                        background: #fff;
                        transition: box-shadow .15s ease;
                    }
                    .cc-item:hover { box-shadow: 0 2px 10px rgba(0,0,0,.08); }
                    .cc-item--event { border-left-color: #3498db; }
                    .cc-item--baptism { border-left-color: #27ae60; }
                    .cc-item--marriage { border-left-color: #9b59b6; }
                    .cc-item--care_cell { border-left-color: #e67e22; }
                    .cc-date {
                        flex: 0 0 84px;
                        text-align: center;
                        margin-right: 1rem;
                    }
                    .cc-date .day { font-size: 1.6rem; font-weight: 700; line-height: 1; color: #2c3e50; }
                    .cc-date .mon { font-size: .8rem; text-transform: uppercase; color: #7f8c8d; }
                    .cc-date .time { font-size: .8rem; color: #95a5a6; }
                    .cc-body { flex: 1; min-width: 0; }
                    .cc-title { font-weight: 600; color: #2c3e50; margin: 0; }
                    .cc-partner { color: #7f8c8d; font-size: .9rem; }
                    .cc-badge {
                        flex: 0 0 auto;
                        font-size: .75rem;
                        font-weight: 600;
                        text-transform: uppercase;
                        letter-spacing: .03em;
                        padding: .3rem .65rem;
                        border-radius: 999px;
                        margin-left: .75rem;
                        color: #fff;
                    }
                    .cc-badge--event { background: #3498db; }
                    .cc-badge--baptism { background: #27ae60; }
                    .cc-badge--marriage { background: #9b59b6; }
                    .cc-badge--care_cell { background: #e67e22; }
                    .cc-empty { text-align: center; color: #95a5a6; padding: 3rem 0; }
                </style>

                <div class="cc-hero">
                    <div class="container">
                        <h1>Church Calendar</h1>
                        <p>Upcoming church activities — events, baptisms, marriages &amp; care cells</p>
                    </div>
                </div>

                <div class="container py-4">
                    <t t-if="months">
                        <t t-foreach="months" t-as="month">
                            <section class="cc-month">
                                <h2 class="cc-month-title" t-out="month['label']"/>
                                <t t-foreach="month['items']" t-as="act">
                                    <div t-attf-class="cc-item cc-item-#{act.activity_type}">
                                        <div class="cc-date">
                                            <div class="day" t-out="act.start.strftime('%d')"/>
                                            <div class="mon" t-out="act.start.strftime('%b')"/>
                                            <div class="time" t-out="act.start.strftime('%H:%M')"/>
                                        </div>
                                        <div class="cc-body">
                                            <div class="cc-title" t-out="act.name"/>
                                            <div class="cc-partner" t-if="act.partner_id" t-out="act.partner_id.name"/>
                                        </div>
                                        <span t-attf-class="cc-badge cc-badge-#{act.activity_type}">
                                            <t t-if="act.activity_type == 'event'">Event</t>
                                            <t t-elif="act.activity_type == 'baptism'">Baptism</t>
                                            <t t-elif="act.activity_type == 'marriage'">Marriage</t>
                                            <t t-elif="act.activity_type == 'care_cell'">Care Cell</t>
                                            <t t-else="" t-out="act.activity_type"/>
                                        </span>
                                    </div>
                                </t>
                            </section>
                        </t>
                    </t>
                    <t t-else="">
                        <div class="cc-empty">
                            <h3>No upcoming activities yet</h3>
                            <p>Please check back later.</p>
                        </div>
                    </t>
                </div>
            </div>
        </t>
    </template>

    <record id="menu_website_church_calendar" model="website.menu">
        <field name="name">Church Calendar</field>
        <field name="url">/church-calendar</field>
        <field name="parent_id" ref="website.main_menu"/>
        <field name="sequence" eval="20"/>
    </record>
</odoo>
