<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>
        <!-- Record dashboard tunggal: landing page Church Management -->
        <record id="church_dashboard_main" model="church.dashboard">
            <field name="name">Church Management Dashboard</field>
        </record>

        <record id="action_church_dashboard" model="ir.actions.act_window">
            <field name="name">Church Management Dashboard</field>
            <field name="res_model">church.dashboard</field>
            <field name="view_mode">form</field>
            <field name="context">{'create': False, 'edit': False}</field>
        </record>

        <record id="view_church_dashboard_form" model="ir.ui.view">
            <field name="name">church.dashboard.form</field>
            <field name="model">church.dashboard</field>
            <field name="arch" type="xml">
                <form string="Church Management Dashboard">
                    <header>
                        <button name="%(church_management.action_church_baptism_registration)d" type="action" string="Baptism Registrations" class="btn-secondary"/>
                        <button name="%(church_management.action_church_marriage_registration)d" type="action" string="Marriage Registrations" class="btn-secondary"/>
                        <button name="%(church_management.action_church_pray_request)d" type="action" string="Pray Requests" class="btn-secondary"/>
                        <button name="%(church_management.action_church_activity)d" type="action" string="Church Calendar" class="btn-secondary"/>
                    </header>
                    <sheet>
                        <div class="row">
                            <!-- ============ JEMAAT ============ -->
                            <div class="col-3">
                                <div class="border rounded p-3 mb-3">
                                    <h4 class="mb-3">👥 Jemaat</h4>
                                    <div class="o_stat_info">
                                        <span class="o_stat_value"><field name="total_members"/></span>
                                        <span class="o_stat_text">Total Jemaat</span>
                                    </div>
                                </div>
                            </div>

                            <!-- ============ BAPTIS ============ -->
                            <div class="col-3">
                                <div class="border rounded p-3 mb-3">
                                    <h4 class="mb-3">💧 Baptis</h4>
                                    <div class="o_stat_info">
                                        <span class="o_stat_value"><field name="baptism_this_month"/></span>
                                        <span class="o_stat_text">Bulan Ini</span>
                                    </div>
                                    <div class="o_stat_info">
                                        <span class="o_stat_value"><field name="baptism_last_month"/></span>
                                        <span class="o_stat_text">Bulan Lalu</span>
                                    </div>
                                    <div class="o_stat_info">
                                        <span class="o_stat_value"><field name="baptism_queued"/></span>
                                        <span class="o_stat_text">Antrian</span>
                                    </div>
                                </div>
                            </div>

                            <!-- ============ PERNIKAHAN ============ -->
                            <div class="col-3">
                                <div class="border rounded p-3 mb-3">
                                    <h4 class="mb-3">💍 Pernikahan</h4>
                                    <div class="o_stat_info">
                                        <span class="o_stat_value"><field name="marriage_this_month"/></span>
                                        <span class="o_stat_text">Bulan Ini</span>
                                    </div>
                                    <div class="o_stat_info">
                                        <span class="o_stat_value"><field name="marriage_last_month"/></span>
                                        <span class="o_stat_text">Bulan Lalu</span>
                                    </div>
                                    <div class="o_stat_info">
                                        <span class="o_stat_value"><field name="marriage_queued"/></span>
                                        <span class="o_stat_text">Antrian</span>
                                    </div>
                                </div>
                            </div>

                            <!-- ============ JADWAL IBADAH ============ -->
                            <div class="col-3">
                                <div class="border rounded p-3 mb-3">
                                    <h4 class="mb-3">⛪ Jadwal Ibadah</h4>
                                    <div class="o_stat_info">
                                        <span class="o_stat_value"><field name="worship_this_month"/></span>
                                        <span class="o_stat_text">Bulan Ini</span>
                                    </div>
                                    <div class="o_stat_info">
                                        <span class="o_stat_value"><field name="worship_last_month"/></span>
                                        <span class="o_stat_text">Bulan Lalu</span>
                                    </div>
                                    <div class="o_stat_info">
                                        <span class="o_stat_value"><field name="worship_upcoming"/></span>
                                        <span class="o_stat_text">Akan Datang</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- ============ JEMAAT PER TIPE ANGGOTA ============ -->
                        <div class="row">
                            <div class="col-12">
                                <div class="border rounded p-3">
                                    <h4 class="mb-3">👥 Jemaat per Tipe Anggota</h4>
                                    <field name="member_type_breakdown" widget="html" readonly="1" nolabel="1"/>
                                </div>
                            </div>
                        </div>

                        <!-- ============ DOA / PRAY REQUESTS ============ -->
                        <div class="row">
                            <div class="col-3">
                                <div class="border rounded p-3 mb-3">
                                    <h4 class="mb-3">🙏 Pray Requests</h4>
                                    <div class="o_stat_info">
                                        <span class="o_stat_value"><field name="pray_this_month"/></span>
                                        <span class="o_stat_text">Bulan Ini</span>
                                    </div>
                                    <div class="o_stat_info">
                                        <span class="o_stat_value"><field name="pray_last_month"/></span>
                                        <span class="o_stat_text">Bulan Lalu</span>
                                    </div>
                                    <div class="o_stat_info">
                                        <span class="o_stat_value"><field name="pray_open"/></span>
                                        <span class="o_stat_text">Sedang Diproses</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </sheet>
                </form>
            </field>
        </record>
    </data>
</odoo>
