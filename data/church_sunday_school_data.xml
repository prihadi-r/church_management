<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data noupdate="1">
        <!-- Sequence nomor murid sekolah minggu -->
        <record id="seq_church_sunday_school_student" model="ir.sequence">
            <field name="name">Sunday School Student</field>
            <field name="code">church.sunday.school.student</field>
            <field name="prefix">SS/%(year)s/</field>
            <field name="padding">4</field>
        </record>

        <!-- ========================================== -->
        <!-- MASTER: CLASS LEVEL                        -->
        <!-- ========================================== -->
        <record id="sunday_school_level_toddler" model="church.sunday.school.class.level">
            <field name="name">Toddler</field>
            <field name="code">toddler</field>
            <field name="sequence">10</field>
            <field name="color">3</field>
        </record>
        <record id="sunday_school_level_kindergarten" model="church.sunday.school.class.level">
            <field name="name">Kindergarten</field>
            <field name="code">kindergarten</field>
            <field name="sequence">20</field>
            <field name="color">4</field>
        </record>
        <record id="sunday_school_level_primary" model="church.sunday.school.class.level">
            <field name="name">Primary</field>
            <field name="code">primary</field>
            <field name="sequence">30</field>
            <field name="color">10</field>
        </record>
        <record id="sunday_school_level_teen" model="church.sunday.school.class.level">
            <field name="name">Teen</field>
            <field name="code">teen</field>
            <field name="sequence">40</field>
            <field name="color">5</field>
        </record>
        <record id="sunday_school_level_youth" model="church.sunday.school.class.level">
            <field name="name">Youth</field>
            <field name="code">youth</field>
            <field name="sequence">50</field>
            <field name="color">6</field>
        </record>

        <!-- ========================================== -->
        <!-- MASTER: TEACHER ROLE                       -->
        <!-- ========================================== -->
        <record id="sunday_school_teacher_role_supervisor" model="church.sunday.school.teacher.role">
            <field name="name">Supervisor</field>
            <field name="code">supervisor</field>
            <field name="sequence">10</field>
            <field name="color">4</field>
        </record>
        <record id="sunday_school_teacher_role_head" model="church.sunday.school.teacher.role">
            <field name="name">Head Teacher</field>
            <field name="code">head_teacher</field>
            <field name="sequence">20</field>
            <field name="color">10</field>
        </record>
        <record id="sunday_school_teacher_role_assistant" model="church.sunday.school.teacher.role">
            <field name="name">Assistant Teacher</field>
            <field name="code">assistant_teacher</field>
            <field name="sequence">30</field>
            <field name="color">3</field>
        </record>
        <record id="sunday_school_teacher_role_substitute" model="church.sunday.school.teacher.role">
            <field name="name">Substitute Teacher</field>
            <field name="code">substitute_teacher</field>
            <field name="sequence">40</field>
            <field name="color">2</field>
        </record>

        <!-- ========================================== -->
        <!-- MASTER: CLASS STATUS                       -->
        <!-- ========================================== -->
        <record id="sunday_school_class_status_planned" model="church.sunday.school.class.status">
            <field name="name">Planned</field>
            <field name="code">planned</field>
            <field name="sequence">10</field>
            <field name="color">0</field>
        </record>
        <record id="sunday_school_class_status_running" model="church.sunday.school.class.status">
            <field name="name">Running</field>
            <field name="code">running</field>
            <field name="sequence">20</field>
            <field name="color">10</field>
        </record>
        <record id="sunday_school_class_status_completed" model="church.sunday.school.class.status">
            <field name="name">Completed</field>
            <field name="code">completed</field>
            <field name="sequence">30</field>
            <field name="color">4</field>
        </record>
        <record id="sunday_school_class_status_cancel" model="church.sunday.school.class.status">
            <field name="name">Cancelled</field>
            <field name="code">cancel</field>
            <field name="sequence">40</field>
            <field name="color">1</field>
        </record>

        <!-- ========================================== -->
        <!-- MASTER: STUDENT STATUS                     -->
        <!-- ========================================== -->
        <record id="sunday_school_student_status_active" model="church.sunday.school.student.status">
            <field name="name">Active</field>
            <field name="code">active</field>
            <field name="sequence">10</field>
            <field name="color">10</field>
        </record>
        <record id="sunday_school_student_status_graduated" model="church.sunday.school.student.status">
            <field name="name">Graduated</field>
            <field name="code">graduated</field>
            <field name="sequence">20</field>
            <field name="color">4</field>
        </record>
        <record id="sunday_school_student_status_withdrawn" model="church.sunday.school.student.status">
            <field name="name">Withdrawn</field>
            <field name="code">withdrawn</field>
            <field name="sequence">30</field>
            <field name="color">2</field>
        </record>
        <record id="sunday_school_student_status_inactive" model="church.sunday.school.student.status">
            <field name="name">Inactive</field>
            <field name="code">inactive</field>
            <field name="sequence">40</field>
            <field name="color">1</field>
        </record>

        <!-- ========================================== -->
        <!-- MASTER: ATTENDANCE STATUS                  -->
        <!-- ========================================== -->
        <record id="sunday_school_attendance_status_present" model="church.sunday.school.attendance.status">
            <field name="name">Present</field>
            <field name="code">present</field>
            <field name="sequence">10</field>
            <field name="color">10</field>
            <field name="is_present" eval="True"/>
        </record>
        <record id="sunday_school_attendance_status_late" model="church.sunday.school.attendance.status">
            <field name="name">Late</field>
            <field name="code">late</field>
            <field name="sequence">20</field>
            <field name="color">3</field>
            <field name="is_present" eval="True"/>
        </record>
        <record id="sunday_school_attendance_status_permission" model="church.sunday.school.attendance.status">
            <field name="name">Permission</field>
            <field name="code">permission</field>
            <field name="sequence">30</field>
            <field name="color">4</field>
        </record>
        <record id="sunday_school_attendance_status_sick" model="church.sunday.school.attendance.status">
            <field name="name">Sick</field>
            <field name="code">sick</field>
            <field name="sequence">40</field>
            <field name="color">2</field>
        </record>
        <record id="sunday_school_attendance_status_absent" model="church.sunday.school.attendance.status">
            <field name="name">Absent</field>
            <field name="code">absent</field>
            <field name="sequence">50</field>
            <field name="color">1</field>
        </record>

        <!-- ========================================== -->
        <!-- MASTER: SESSION STATUS                     -->
        <!-- ========================================== -->
        <record id="sunday_school_session_status_planned" model="church.sunday.school.session.status">
            <field name="name">Planned</field>
            <field name="code">planned</field>
            <field name="sequence">10</field>
            <field name="color">0</field>
        </record>
        <record id="sunday_school_session_status_in_progress" model="church.sunday.school.session.status">
            <field name="name">In Progress</field>
            <field name="code">in_progress</field>
            <field name="sequence">20</field>
            <field name="color">3</field>
        </record>
        <record id="sunday_school_session_status_done" model="church.sunday.school.session.status">
            <field name="name">Done</field>
            <field name="code">done</field>
            <field name="sequence">30</field>
            <field name="color">10</field>
        </record>
        <record id="sunday_school_session_status_cancel" model="church.sunday.school.session.status">
            <field name="name">Cancelled</field>
            <field name="code">cancel</field>
            <field name="sequence">40</field>
            <field name="color">1</field>
        </record>
    </data>
</odoo>
