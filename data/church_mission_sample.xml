            <field name="phone">021-5566-1001</field>
            <field name="city">Jakarta</field>
            <field name="field_ids" eval="[(6, 0, [ref('mission_field_sumatra'), ref('mission_field_papua'), ref('mission_field_southeast_asia')])]"/>
